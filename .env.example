# ── Athena Core ───────────────────────────────────────────────────────────────
# Endpoint must be created in Athena UI with kind = "gsm".
# Issue a token once: Gateway → endpoint → «Токен».
ATHENA_ENABLED=true
ATHENA_URL=ws://192.168.1.10:8000/api/device/ws
ATHENA_TOKEN=dev_REPLACE_ME

# ── Modem ─────────────────────────────────────────────────────────────────────
# Linux: usually /dev/ttyUSB2 (AT port). Windows: COM5.
MODEM_PORT=/dev/ttyUSB2
MODEM_BAUD=115200
MODEM_MOCK=false

# ── Local HTTP API (Home Assistant / diagnostics) ─────────────────────────────
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8099
# Long random string. HA integration and REST clients use it as Bearer token.
API_TOKEN=change-me-please
STATE_DIR=./data

# ── Audio bridge (GSM call ↔ Athena speaker) ─────────────────────────────────
AUDIO_BRIDGE_ENABLED=false
AUDIO_CAPTURE_DEVICE=plughw:1,0
AUDIO_PLAYBACK_DEVICE=plughw:1,0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
